# Backend: copy to .env in terminal/, restart backend after changes.
ALPHA_VANTAGE_API_KEY=
# Optional AI synthesis. Keys stay server-side. auto prefers OpenAI, then Gemini.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DB_PATH=terminal.sqlite3
# Frontend; default points to local FastAPI
VITE_API_URL=http://127.0.0.1:8000
